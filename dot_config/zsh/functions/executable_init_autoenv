#!/usr/bin/env zsh

echo "Setting up autoenv..."

# 1. Create directories and blank files
mkdir -p scripts
touch .env
touch scripts/utils.sh

# 2. Create the enter script (.autoenv)
cat << 'EOF' > .autoenv
# Export variables
set -a
[ -f "$AUTOENV_CUR_DIR/.env" ] && source "$AUTOENV_CUR_DIR/.env"
set +a

# Load functions
[ -f "$AUTOENV_CUR_DIR/scripts/utils.sh" ] && source "$AUTOENV_CUR_DIR/scripts/utils.sh"
EOF

# 3. Create the leave script (.autoenv.leave)
cat << 'EOF' > .autoenv.leave
# Unset variables defined in .env
if [ -f "$AUTOENV_CUR_DIR/.env" ]; then
  while IFS='=' read -r key _; do
    # Skip empty lines and comments
    [[ -n "$key" && ! "$key" =~ ^# ]] && unset "$key"
  done < "$AUTOENV_CUR_DIR/.env"
fi

# Unset functions defined in utils.sh by grabbing their names with grep
if [ -f "$AUTOENV_CUR_DIR/scripts/utils.sh" ]; then
  for func in $(grep -oE '^[a-zA-Z0-9_:-]+\s*\(\)' "$AUTOENV_CUR_DIR/scripts/utils.sh" | sed 's/[[:space:]]*()//'); do
    unset -f "$func"
  done
fi
EOF

# 4. Append to .gitattributes
cat << 'EOF' >> .gitattributes
.env filter=ageencrypt diff=ageencrypt
EOF
